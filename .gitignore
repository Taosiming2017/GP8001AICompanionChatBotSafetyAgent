# Whitelist: git ignores everything, then only our own source, config and small data
# files are allowed. Libraries are NOT in the repo: install them with requirements.txt
# (see README, Setup).
*
!*/
!*.py
!*.json
!*.jsonl
!*.yaml
!*.yml
!*.md
!requirements*.txt
!pytest.ini
!*.html
!*.bat
!.gitignore
!.gitattributes
!.gitkeep
!data/synthetic/*.csv

# ...but never these, even when the file type is allowed above
.venv/
venv/
__pycache__/
.pytest_cache/
.env
*.env
.streamlit/
.vscode/
.idea/

# everything the pipeline makes: runs/full, runs/quick, runs/archive
runs/

# old output folders from before runs/ existed
/models/
/reports/
data/raw/
data/interim/
data/processed/
data/review/
README_old.md
_to_delete/
